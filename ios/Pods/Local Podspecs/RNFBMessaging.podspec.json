    ],
    "React-renderercss": [

    ],
    "hermes-engine": [

    ],
    "glog": [

    ],
    "boost": [

    ],
    "DoubleConversion": [

    ],
    "fast_float": [

    ],
    "fmt": [

    ],
    "RCT-Folly": [

    ],
    "SocketRocket": [

    ],
    "RCT-Folly/Fabric": [

    ]
  },
  "compiler_flags": "-DRCT_NEW_ARCH_ENABLED=1",
  "static_framework": false
}
